{
  "name": "fuse",
  "private": true,
  "version": "0.1.0",
  "description": "FUSE \u2014 the execution layer for Bitcoin Cash DeFi",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "compile:contracts": "pnpm --filter @fuse/contracts compile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm --filter @fuse/web build",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:web": "pnpm --filter @fuse/web dev",
    "solvers": "tsx scripts/demo/run-network.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "9",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "3"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@fastify/cors": "^11.4.3",
    "@fuse/auction": "workspace:*",
    "@fuse/compiler": "workspace:*",
    "@fuse/config": "workspace:*",
    "@fuse/contracts": "workspace:*",
    "@fuse/core": "workspace:*",
    "@fuse/flash-liquidity": "workspace:*",
    "@fuse/indexer-client": "workspace:*",
    "@fuse/intent": "workspace:*",
    "@fuse/math": "workspace:*",
    "@fuse/notifications": "workspace:*",
    "@fuse/policy-engine": "workspace:*",
    "@fuse/proof-verifier": "workspace:*",
    "@fuse/protocol-adapters": "workspace:*",
    "@fuse/risk-engine": "workspace:*",
    "@fuse/simulation": "workspace:*",
    "@fuse/solver-sdk": "workspace:*",
    "@fuse/store": "workspace:*",
    "@fuse/transaction-composer": "workspace:*",
    "@fuse/wallet": "workspace:*",
    "@paryonusd/contracts": "1.1.0",
    "cashc": "0.14.0",
    "cashscript": "0.14.0",
    "fastify": "5",
    "zod": "3"
  }
}
